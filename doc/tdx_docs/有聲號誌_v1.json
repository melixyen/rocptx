              "ChanghuaCounty": "彰化縣",
              "Chiayi": "嘉義市",
              "ChiayiCounty": "嘉義縣",
              "HualienCounty": "花蓮縣",
              "Keelung": "基隆市",
              "HsinchuCounty": "新竹縣",
              "NantouCounty": "南投縣",
              "NewTaipei": "新北市",
              "PenghuCounty": "澎湖縣",
              "LienchiangCounty": "連江縣",
              "Hsinchu": "新竹市",
              "Taoyuan": "桃園市",
              "Taipei": "臺北市",
              "PingtungCounty": "屏東縣",
              "YilanCounty": "宜蘭縣",
              "KinmenCounty": "金門縣",
              "YunlinCounty": "雲林縣"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "description": "挑選",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "description": "過濾",
            "schema": {
              "type": "string"
            }
          },
          {
